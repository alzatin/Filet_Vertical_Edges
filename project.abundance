      ],
      "interpreterVersion": 1,
      "code": "/**\n * Fillets edges on geometry with optional region-based filtering.\n * If a region is provided, only fillets edges within that bounding box.\n * All parameters have defaults for immediate use.\n */\nfunction run(\n  shape: Assembly,\n  radius: number = 2,\n  region?: Assembly\n){\n  // ── Step 1: Determine edge filter based on region ──────────────────\n  let edgeFilter: (e: any) => boolean;\n  \n  if (region) {\n    // Get bounding box from region geometry\n    const regionGeometry = region.geometry;\n    console.log(\"regionGeometry\", regionGeometry)\n    if (Array.isArray(regionGeometry) && regionGeometry[0]) {\n      \n      const bounds = regionGeometry[0].boundingBox?.();\n      if (bounds) {\n        edgeFilter = (e) => e.inDirection(\"Z\").inBox(bounds.min, bounds.max);\n        console.log(\"filtering by region\")\n      } else {\n        edgeFilter = (e) => e.inDirection(\"Z\");\n      }\n    } else {\n      edgeFilter = (e) => e.inDirection(\"Z\");\n    }\n  } else {\n    // No region: fillet only vertical (Z-direction) edges\n    edgeFilter = (e) => e.inDirection(\"Z\");\n  }\n\n  // ── Step 2: Apply fillet to each leaf geometry ──────────────────\n  const filletedAssembly = new Assembly(shape).onLeafs((leaf) => {\n    if (leaf.is3D()) {\n      leaf.geometry = leaf.geometry.fillet(radius, edgeFilter);\n    }\n    return leaf;\n  });\n\n  return filletedAssembly;\n}",
      "compiledCode": "\"use strict\";\n/**\n * Fillets edges on geometry with optional region-based filtering.\n * If a region is provided, only fillets edges within that bounding box.\n * All parameters have defaults for immediate use.\n */\nfunction run(shape, radius = 2, region) {\n    // ── Step 1: Determine edge filter based on region ──────────────────\n    let edgeFilter;\n    if (region) {\n        // Get bounding box from region geometry\n        const regionGeometry = region.geometry;\n        console.log(\"regionGeometry\", regionGeometry);\n        if (Array.isArray(regionGeometry) && regionGeometry[0]) {\n            const bounds = regionGeometry[0].boundingBox?.();\n            if (bounds) {\n                edgeFilter = (e) => e.inDirection(\"Z\").inBox(bounds.min, bounds.max);\n                console.log(\"filtering by region\");\n            }\n            else {\n                edgeFilter = (e) => e.inDirection(\"Z\");\n            }\n        }\n        else {\n            edgeFilter = (e) => e.inDirection(\"Z\");\n        }\n    }\n    else {\n        // No region: fillet only vertical (Z-direction) edges\n        edgeFilter = (e) => e.inDirection(\"Z\");\n    }\n    // ── Step 2: Apply fillet to each leaf geometry ──────────────────\n    const filletedAssembly = new Assembly(shape).onLeafs((leaf) => {\n        if (leaf.is3D()) {\n            leaf.geometry = leaf.geometry.fillet(radius, edgeFilter);\n        }\n        return leaf;\n    });\n    return filletedAssembly;\n}\n"
    },
